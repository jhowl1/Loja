<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Farmácia & Cosméticos</title>
  <style>
    body {
      background-color: #ffffff;
      font-family: 'Roboto', sans-serif;
      color: #333;
      margin: 0;
    }
    header {
      background: #4caf50;
      padding: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: #fff;
    }
    #carrinhoIcon { cursor: pointer; font-size: 20px; }
    #produtos {
      display: grid;
      grid-template-columns: repeat(auto-fill,minmax(220px,1fr));
      gap: 20px;
      padding: 20px;
    }
    .produto {
      background: #fff;
      border-radius: 8px;
      padding: 15px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      text-align: center;
    }
    .produto img {
      max-width: 100%;
      height: 150px;
      object-fit: cover;
      border-radius: 6px;
    }
    .preco { font-weight: bold; color: #2e7d32; }
    .indisponivel { color: #b00; font-weight: bold; }
    #carrinho {
      position: fixed;
      right: -400px;
      top: 0;
      width: 320px;
      height: 100%;
      background: #ffffff;
      box-shadow: -2px 0 5px rgba(0,0,0,0.3);
      padding: 20px;
      transition: right 0.3s ease;
      border-left: 5px solid #2e7d32;
    }
    #carrinho.aberto { right: 0; }
    #carrinho h2 {
      margin-top: 0;
      background: #2e7d32;
      color: #fff;
      padding: 10px;
      border-radius: 4px;
    }
    button {
      background: #4caf50;
      border: none;
      padding: 10px 15px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
      margin-top: 10px;
      color: #fff;
    }
    button:hover { background: #388e3c; }
    .fecharCarrinho {
      background: #2e7d32;
      margin-bottom: 15px;
    }
  </style>
</head>
<body>
  <header>
    <h1>Catálogo de Farmácia & Cosméticos</h1>
    <div id="carrinhoIcon" onclick="abrirCarrinho()">🛒 <span id="qtdItens">0</span></div>
  </header>

  <main>
    <div id="produtos"></div>
  </main>

  <aside id="carrinho">
    <button class="fecharCarrinho" onclick="abrirCarrinho()">Fechar Carrinho ✖</button>
    <h2>🛒 Carrinho</h2>
    <ul id="listaCarrinho"></ul>
    <p>Total: <span id="total">R$ 0,00</span></p>

    <h3>Forma de pagamento</h3>
    <select id="pagamento">
      <option value="credito">💳 Cartão de Crédito</option>
      <option value="pix">🔑 Pix</option>
    </select>

    <div id="parcelas" style="display:none;">
      <label>Parcelas:</label>
      <select id="qtdParcelas">
        <option value="1">1x</option><option value="2">2x</option>
        <option value="3">3x</option><option value="6">6x</option>
        <option value="12">12x</option>
      </select>
    </div>

    <button onclick="finalizarCompra()">Finalizar Compra</button>
  </aside>

  <script>
    let carrinho = [];

    function adicionarCarrinho(produto) {
      carrinho.push(produto);
      atualizarCarrinho();
    }

    function atualizarCarrinho() {
      const lista = document.getElementById("listaCarrinho");
      lista.innerHTML = "";
      let total = 0;
      carrinho.forEach(p => {
        const item = document.createElement("li");
        item.textContent = `${p.nome} - R$ ${Number(p.preco).toFixed(2)}`;
        lista.appendChild(item);
        total += Number(p.preco);
      });
      document.getElementById("total").textContent = `R$ ${total.toFixed(2)}`;
      document.getElementById("qtdItens").textContent = carrinho.length;
    }

    function abrirCarrinho() {
      document.getElementById("carrinho").classList.toggle("aberto");
    }

    function finalizarCompra() {
      const forma = document.getElementById("pagamento").value;
      let mensagem = "Resumo da compra:\n";
      carrinho.forEach(p => {
        mensagem += `- ${p.nome} R$ ${Number(p.preco).toFixed(2)}\n`;
      });
      mensagem += `\nTotal: ${document.getElementById("total").textContent}\n`;
      if (forma === "credito") {
        const parcelas = document.getElementById("qtdParcelas").value;
        mensagem += `Forma de pagamento: Cartão de Crédito em ${parcelas}x.`;
      } else {
        mensagem += "Forma de pagamento: Pix.\nChave Pix: 48051541871\nBanco: Santander\nTitular: Johnatan Oliveira Ferreira.";
      }
      mensagem += "\n\nPor favor, envie o comprovante para meu WhatsApp: 11 94852-3462.";
      const url = `https://wa.me/5511948523462?text=${encodeURIComponent(mensagem)}`;
      window.open(url,"_blank");
    }

    document.getElementById("pagamento").addEventListener("change",function(){
      document.getElementById("parcelas").style.display=this.value==="credito"?"block":"none";
    });

    function formatarFoto(link) {
      if (link.includes("drive.google.com")) {
        const match = link.match(/\/d\/(.*?)\//);
        if (match && match[1]) {
          return `https://drive.google.com/uc?export=view&id=${match[1]}`;
        }
      }
      return link;
    }

    function renderizarProdutos(produtos) {
      const container=document.getElementById("produtos");
      container.innerHTML="";
      produtos.forEach(p=>{
        const card=document.createElement("div");
        card.className="produto";
        card.innerHTML=`
          <img src="${formatarFoto(p.foto)}" alt="${p.nome}">
          <h3>${p.nome}</h3>
          <p class="preco">R$ ${Number(p.preco).toFixed(2)}</p>
          <p class="${p.status==="disponível"?"":"indisponivel"}">${p.status}</p>
          ${p.status==="disponível"?`<button onclick='adicionarCarrinho(${JSON.stringify(p)})'>Adicionar ao carrinho</button>`:""}
        `;
        container.appendChild(card);
      });
    }

    // Conexão com planilha + fallback
    const sheetId="14jIYmfNIoLSxvnBuHMByplsNXLtD_kC0WFlOmEYWwEk";
    const sheetName="Página1";
    const url=`https://docs.google.com/spreadsheets/d/${sheetId}/gviz/tq?tqx=out:json&sheet=${sheetName}`;

    fetch(url).then(res=>res.text()).then(data=>{
      try {
        const json=JSON.parse(data.substr(47).slice(0,-2));
        const rows=json.table.rows;
        const produtos=rows.map(r=>({
          nome:r.c[0]?.v||"",
          foto:r.c[1]?.v||"",
          quantidade:r.c[2]?.v||0,
          preco:r.c[3]?.v||0,
          status:r.c[4]?.v||"disponível"
        }));
        renderizarProdutos(produtos);
      } catch(e) {
        console.error("Erro ao ler planilha:",e);
        renderizarProdutos([
          { nome:"Creme Hidratante", foto:"https://via.placeholder.com/150", preco:29.90, status:"disponível" },
          { nome:"Shampoo Anticaspa", foto:"https://via.placeholder.com/150", preco:19.90, status:"disponível" }
        ]);
      }
    }).catch(err=>{
      console.error("Erro de conexão:",err);
      renderizarProdutos([
        { nome:"Produto Exemplo", foto:"https://via.placeholder.com/150", preco:9.90, status:"disponível" }
      ]);
    });
  </script>
</body>
</html>